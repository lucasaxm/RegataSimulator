# Placeholder-only local setup; Spring Boot does not load this file automatically.
# Supply values through your IDE/process environment or configure loading explicitly.
# IMPORTANT: .env was not Git-ignored at review time. Ignore it BEFORE adding real secrets.
# Use a dedicated dev bot and isolated storage; startup currently calls Telegram/schedules jobs.
SPRING_PROFILES_ACTIVE=dev
REGATA_SIMULATOR_ENC_PASSWORD=replace-with-local-only-decryption-key
REGATA_SIMULATOR_DB_PATH=/replace/with/dev-only/db
REGATA_SIMULATOR_SOURCES_PATH=/replace/with/dev-only/sources
REGATA_SIMULATOR_TEMPLATES_PATH=/replace/with/dev-only/templates
MAGICK_PATH=/replace/with/imagemagick/executable