{
  "name": "regata-template-creator",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=22.23.1 <23" },
  "scripts": {
    "check": "node build.mjs --check",
    "test": "node --test test/model.test.mjs test/media.test.mjs test/telegram.test.mjs",
    "test:browser": "playwright test",
    "build": "node build.mjs",
    "start": "node server.mjs",
    "audit": "npm audit --audit-level=low",
    "verify:package": "node verify-package.mjs"
  },
  "dependencies": { "konva": "10.7.1" },
  "devDependencies": {
    "@playwright/test": "1.64.0",
    "esbuild": "0.28.2"
  }
}